# Allow only the agreed deliverable areas.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/extra-design/
!/tests/
!/report/
!/output/
!/docs/
!/ai-record/

/extra-design/*
!/extra-design/oslab3_probe.c
!/extra-design/Makefile
!/extra-design/oslab3_probe.conf
!/extra-design/install-probe.sh
/tests/*
!/tests/test_boot_probe.sh
!/tests/collect-boot-performance.sh
!/tests/check_probe_contract.py

# Credential-bearing original: local only, never publish.
/ai-record/检查配置以及书写方案.png

/report/*
!/report/main.tex
!/report/scripts/
!/report/logs/
!/report/figures/
/report/figures/*
!/report/figures/env-baseline.png
!/report/figures/source-analysis.png
!/report/figures/kernel-config.png
!/report/figures/build-result.png
!/report/figures/boot-verify.png
!/report/figures/extra-design-test.png
!/report/figures/boot-analysis.svg

/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/实验三_Linux启动初始化过程探析_XXX.pdf

# Defense against accidentally adding local authentication or build material.
**/.env
**/.env.*
**/.ssh/
**/id_rsa*
**/id_ed25519*
**/authorized_keys
**/*.pem
**/*.key
**/*.ko
**/*.o
**/*.cmd
**/Module.symvers
**/modules.order
**/__pycache__/
**/*.aux
**/*.xdv
**/*.toc
**/*.fls
**/*.fdb_latexmk
